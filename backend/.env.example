# Porta da API
PORT=3000

# Conexão com o PostgreSQL: postgres://usuario:senha@host:porta/banco
DATABASE_URL=postgres://postgres:postgres@localhost:5432/coin

# Segredo usado para assinar os tokens JWT (troque por um texto longo e aleatório)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=1h

# Origem do front-end permitida pelo CORS
CORS_ORIGIN=http://localhost:5173
